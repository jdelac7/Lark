# AI backend: "google" or "openrouter" (default: google)
AI_BACKEND=google

# Google AI Studio (used when AI_BACKEND=google)
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-3-flash-preview

# OpenRouter (used when AI_BACKEND=openrouter)
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL=google/gemini-3-flash-preview

# Server port (default: 8080)
PORT=8080

# Polar.sh organization ID (for license key validation)
POLAR_ORGANIZATION_ID=your-polar-org-id
