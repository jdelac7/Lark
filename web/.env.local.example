# Polar.sh configuration
POLAR_ACCESS_TOKEN=your-polar-access-token
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret
POLAR_ORGANIZATION_ID=your-polar-org-id

# Auth
AUTH_SECRET=your-random-secret-here

# Admin dashboard — path to Go server's cost.db
COST_DB_PATH=../cost.db

# Public (exposed to browser)
NEXT_PUBLIC_POLAR_PRODUCT_ID=your-polar-product-id
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Game server (internal, used by Next.js rewrites — not exposed to browser)
GAME_SERVER_INTERNAL_URL=http://localhost:9292
